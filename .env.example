# ==============================================================================
# SENTINEL Sovereign Core v3.0 — Environment Configuration Template
# ==============================================================================

# --- Networking & Server Topology ---
HOST=127.0.0.1
PORT=5001
SENTINEL_PORT=5001
NODE_ENV=production

# --- Privacy Shield (FastAPI / Presidio Service) ---
PRIVACY_HOST=127.0.0.1
PRIVACY_PORT=8000
PRIVACY_SERVICE_URL=http://127.0.0.1:8000

# --- Python & Analyzer Environment ---
PYTHON_EXECUTABLE=.venv/bin/python

# --- Ephemeral RAM Vault & Storage Invariants ---
MAX_FILE_SIZE_MB=100
SENTINEL_ALLOW_DISK_TEMP=0
SENTINEL_ALLOW_UNSANDBOXED_ARCHIVE_WORKER=1
SENTINEL_ALLOW_UNSANDBOXED_ANALYZERS=1
SENTINEL_ALLOW_CROSS_PLATFORM=1
# Set to 0 to run seamlessly across all OSes (Linux, macOS, Windows) without native ClamAV daemon
SENTINEL_REQUIRE_CLAMAV=0

# --- Cryptographic Attestation & Local Root Identity ---
SENTINEL_SIGNING_KEY_PATH=data/sentinel-signing.key

# --- AI Guardian Browser Extension Loopback Gateway ---
SENTINEL_EXTENSION_ORIGIN=chrome-extension://sentinel-ai-guardian
SENTINEL_EXTENSION_TOKEN=c7b8e1f0a2d34567890abcdef1234567890abcdef1234567890abcdef1234567

# --- Offline Audit Toolchain Paths ---
SENTINEL_SEMGREP_BIN=semgrep
SENTINEL_SEMGREP_CONFIG=p/default
SENTINEL_GITLEAKS_BIN=gitleaks
SENTINEL_OSV_SCANNER_BIN=osv-scanner
SENTINEL_UPDATE_CLAMAV_DB=0
