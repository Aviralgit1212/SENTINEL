{
  "manifest_version": 3,
  "name": "SENTINEL AI Guardian (Local Preview)",
  "version": "0.1.0",
  "description": "Hold-before-send privacy checks for supported AI chat composers using the local SENTINEL gateway.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5001/*", "http://localhost:5001/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  ]
}
